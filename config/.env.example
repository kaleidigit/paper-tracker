TZ=Asia/Shanghai
CONFIG_PATH=./config/config.json

# DeepSeek API key
OPENAI_COMPATIBLE_API_KEY=replace-with-your-deepseek-api-key

# NetEase 163 SMTP (enable SMTP in 163 mail settings to get auth code)
EMAIL_USER=your-email@163.com
EMAIL_PASS=your-smtp-auth-code
EMAIL_RECIPIENTS=teacher@qq.com,colleague@163.com
